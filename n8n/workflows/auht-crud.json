    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with chave as (\n  select upper(encode(extensions.gen_random_bytes(6), 'hex')) as valor\n),\nnovo_usuario as (\n  insert into public.users (telegram_id, first_name, username, access_key_hash)\n  select $1::bigint, $2::text, $3::text,\n         extensions.crypt(chave.valor, extensions.gen_salt('bf', 10))\n  from chave\n  on conflict (telegram_id) do nothing\n  returning id, first_name, created_at\n)\nselect novo_usuario.id,\n       novo_usuario.first_name,\n       chave.valor as access_key\nfrom novo_usuario, chave;",
        "options": {
          "queryReplacement": "{{ [ $('Normalizar Entrada').item.json.telegram_id, $('Normalizar Entrada').item.json.first_name, $('Normalizar Entrada').item.json.username ] }}"
