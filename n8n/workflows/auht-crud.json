      ],
      "id": "1e352d12-26bc-48fc-96b8-cf43cd478044",
      "name": "Listar Tarefas",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "MiidImH7NC2nDyrG",
          "name": "Postgres/supabase - tasks bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with entrada as (\n  select $1::uuid as user_id,\n         left(nullif(trim($2::text), ''), 200) as title\n),\nproximo as (\n  select coalesce(max(t.numero), 0) + 1 as numero\n  from public.tasks t, entrada e\n  where t.user_id = e.user_id\n)\ninsert into public.tasks (user_id, numero, title)\nselect e.user_id, p.numero, e.title\nfrom entrada e, proximo p\nwhere e.title is not null\nreturning numero, title;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $('Normalizar Entrada').first().json.argumento ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1088,
        -688
      ],
      "id": "77e9c898-2c45-4842-a8cf-89777ff739fb",
      "name": "Criar Tarefa",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "MiidImH7NC2nDyrG",
          "name": "Postgres/supabase - tasks bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const entrada = $('Normalizar Entrada').first().json;\nconst comando = entrada.comando;\n\n// Descarta o item vazio que o \"Always Output Data\" injeta quando o SQL não retorna nada\nconst itens = $input.all()\n  .map((i) => i.json)\n  .filter((j) => j && Object.keys(j).length > 0);\n\nconst esc = (v) =>\n  String(v ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n\nconst ICONE_STATUS = { pendente: '⏳', em_andamento: '🔄' };\nconst ICONE_PRIO = { baixa: '🔵', media: '🟡', alta: '🟠', urgente: '🔴' };\n\nconst AJUDA = [\n  '<b>Comandos disponíveis</b>',\n  '',\n  '<code>/add Comprar café</code> — cria uma tarefa',\n  '<code>/listar</code> — mostra suas tarefas em aberto',\n  '<code>/concluir 3</code> — conclui a tarefa #3',\n  '<code>/remover 3</code> — apaga a tarefa #3',\n  '<code>/ajuda</code> — mostra esta mensagem',\n].join('\\n');\n\nlet mensagem;\n\nswitch (comando) {\n  case '/add':\n    mensagem = itens.length\n      ? `✅ Tarefa <b>#${itens[0].numero}</b> criada:\\n${esc(itens[0].title)}`\n      : `⚠️ Preciso do texto da tarefa.\\n\\nExemplo: <code>/add Comprar café</code>`;\n    break;\n\n  case '/listar':\n    mensagem = itens.length\n      ? '📋 <b>Suas tarefas em aberto</b>\\n\\n' +\n        itens\n          .map(\n            (t) =>\n              `${ICONE_STATUS[t.status] ?? '•'} <b>#${t.numero}</b> ${esc(t.title)}\\n` +\n              `      ${ICONE_PRIO[t.priority] ?? ''} ${t.priority}` +\n              (t.category ? ` · ${esc(t.category)}` : ''),\n          )\n          .join('\\n\\n')\n      : '📭 Você não tem tarefas em aberto.\\n\\nCrie a primeira com <code>/add Minha tarefa</code>';\n    break;\n\n  case '/concluir':\n    mensagem = itens.length\n      ? `🎉 Tarefa <b>#${itens[0].numero}</b> concluída:\\n${esc(itens[0].title)}`\n      : '⚠️ Não encontrei essa tarefa em aberto.\\n\\nConfira o número com <code>/listar</code>';\n    break;\n\n  case '/remover':\n    mensagem = itens.length\n      ? `🗑 Tarefa <b>#${itens[0].numero}</b> removida:\\n<s>${esc(itens[0].title)}</s>`\n      : '⚠️ Não encontrei essa tarefa.\\n\\nConfira o número com <code>/listar</code>';\n    break;\n\n  default: {\n    const saudacao =\n      comando === '/start' ? `👋 Bem-vinda de volta, <b>${entrada.first_name_safe}</b>!\\n\\n` : '';\n    mensagem = saudacao + AJUDA;\n  }\n}\n\nreturn [{ json: { chat_id: entrada.chat_id, mensagem } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
