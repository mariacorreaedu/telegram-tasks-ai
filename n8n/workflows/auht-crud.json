    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select numero, title, status, priority, category, due_date\nfrom public.tasks\nwhere user_id = $1::uuid\n  and status not in ('concluida', 'cancelada')\norder by\n  case priority\n    when 'urgente' then 1\n    when 'alta'    then 2\n    when 'media'   then 3\n    else 4\n  end,\n  numero\nlimit 30;",
        "options": {
          "queryReplacement": "={{ [ $json.id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
