    {
      "parameters": {
        "jsCode": "const update = $input.first().json;\nconst msg = update.message ?? update.edited_message;\n\nif (!msg?.from || !msg?.chat) {\n  return [];\n}\n\n// Escapa os 3 caracteres que o parse_mode HTML do Telegram interpreta\nconst escapeHtml = (valor) =>\n  String(valor ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n\nconst texto = (msg.text ?? '').trim();\nconst firstName = (msg.from.first_name ?? 'Usuário').trim().slice(0, 80);\n\nreturn [{\n  json: {\n    telegram_id: msg.from.id,\n    chat_id: msg.chat.id,\n    first_name: firstName,            // valor cru → vai para o banco\n    first_name_safe: escapeHtml(firstName), // valor escapado → vai para a tela\n    username: msg.from.username ?? null,\n    texto,\n    comando: texto.split(/\\s+/)[0].toLowerCase(),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
